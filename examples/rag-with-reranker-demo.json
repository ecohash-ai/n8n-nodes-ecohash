      "position": [
        -500,
        400
      ],
      "credentials": {
        "ecoHashApi": {
          "name": "EcoHash API smoke"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { ready: true } }];"
      },
      "id": "code-reduce",
      "name": "Reduce To One Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
